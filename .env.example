# Куда приходят заявки (один или несколько через запятую)
EMAIL_TO=you@example.com

# Gmail: в аккаунте Google включите двухэтапную проверку и создайте «Пароль приложения»
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Для порта 465 поставьте SMTP_SECURE=true
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Необязательно: заголовок From (по умолчанию = SMTP_USER)
# SMTP_FROM="Заявка с сайта <youraddress@gmail.com>"

# Опционально: дублирование в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
